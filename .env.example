# ─────────────────────────────────────────────────────────────────────────
# Technology Solutions inquiry emails — server-side settings
# Set these in Vercel → Project → Settings → Environment Variables.
# NEVER put them in HTML or browser JavaScript.
# For local testing, copy this file to .env (it is git-ignored).
# ─────────────────────────────────────────────────────────────────────────

# REQUIRED — Resend API key (https://resend.com → API Keys). Starts with "re_".
RESEND_API_KEY=

# REQUIRED — the "From" address. Must be on a domain you have verified in Resend,
# e.g. a subdomain like updates.aontechnology.com or the main domain.
INQUIRY_FROM_EMAIL="Aon Technology Solutions Website <website@aontechnology.com>"

# Optional — where inquiries are delivered. Defaults to info@aontechnology.com.
INQUIRY_TO_EMAIL=info@aontechnology.com

# Recommended (Production environment only) — exact address(es) of this page, comma-separated,
# no trailing slash. If left empty, only the same host that serves the page is allowed —
# which also keeps Vercel Preview links working.
ALLOWED_ORIGINS=https://solutions.aontechnology.com

# Optional — time zone used for the "Submitted" date/time in the email.
INQUIRY_TIMEZONE=America/Chicago

# Optional — rate limit per visitor (defaults: 6 submissions per 600 seconds).
RATE_LIMIT_MAX=6
RATE_LIMIT_WINDOW_SECONDS=600

# Optional — Upstash Redis (free tier works; available in the Vercel Marketplace) for a
# rate limit shared across all function instances. The Marketplace names
# KV_REST_API_URL / KV_REST_API_TOKEN are also accepted. Without these, a
# per-instance in-memory limit is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Only if the Cloudflare DNS record is PROXIED (orange cloud). Leave false for "DNS only"
# (grey cloud, recommended by Vercel). Makes the rate limit use Cloudflare's visitor IP.
BEHIND_CLOUDFLARE_PROXY=false

# Testing only — when "true" the email is NOT sent (it is logged instead).
# Never set this in production.
EMAIL_DRY_RUN=false
